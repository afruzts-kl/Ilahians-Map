# =========================================================
# ILahiaNav: Smart Campus Navigation System
# Supabase Configuration (REQUIRED for admin features)
# =========================================================

# The application works with BOTH:
# 1) Vercel-Supabase Native Integration variables:
#    NEXT_PUBLIC_SUPABASE_URL
#    NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# 2) Standard Vite variables:
#    VITE_SUPABASE_URL
#    VITE_SUPABASE_ANON_KEY

# For local development with Vite (REQUIRED for admin features):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Or using Vercel integration variable names:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Without Supabase credentials, the app runs in public-only mode:
# - Map shows empty state ("No locations added yet")
# - Admin features (/admin route) will not work
# - No data persistence across devices
