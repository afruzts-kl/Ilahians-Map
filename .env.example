# =========================================================
# ILahiaNav: Smart Campus Navigation System
# Supabase Configuration
# =========================================================

# The application automatically detects and works with BOTH:
# 1) Vercel-Supabase Native Integration variables:
#    NEXT_PUBLIC_SUPABASE_URL
#    NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# 2) Standard Vite variables:
#    VITE_SUPABASE_URL
#    VITE_SUPABASE_ANON_KEY

# For local development with Vite:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Or using Vercel integration variable names:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
